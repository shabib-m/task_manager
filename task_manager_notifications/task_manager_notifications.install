<?php
/**
 * @file
 * دوال التثبيت وإلغاء التثبيت لوحدة التنبيهات.
 */

/**
 * Implements hook_install().
 */
function task_manager_notifications_install() {
  $config = config('task_manager_notifications.settings');
  $config->set('notify_assignee', TRUE);
  $config->set('notify_last_replier', FALSE);
  $config->set('notify_admins', FALSE);
  $config->set('skip_self', TRUE);
  $config->set('use_queue', FALSE);
  $config->save();

  backdrop_set_message(t('تم تثبيت وحدة تنبيهات المهام. يرجى زيارة <a href="@url">صفحة الإعدادات</a>.', array(
    '@url' => url('admin/config/task-manager/notifications'),
  )));
}

/**
 * Implements hook_uninstall().
 */
function task_manager_notifications_uninstall() {
  config('task_manager_notifications.settings')->delete();

  // حذف جدول التنبيهات.
  db_drop_table('task_manager_notifications');

  backdrop_set_message(t('تم إلغاء تثبيت وحدة تنبيهات المهام.'));
}

/**
 * Implements hook_schema().
 */
function task_manager_notifications_schema() {
  $schema['task_manager_notifications'] = array(
    'description' => 'تنبيهات المهام.',
    'fields' => array(
      'nid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'معرّف العقدة.',
      ),
      'cid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'معرّف التعليق.',
      ),
      'uid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'معرّف المستخدم المستهدف.',
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'وقت الإنشاء.',
      ),
      'status' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => '0 = غير مقروء، 1 = مقروء.',
      ),
    ),
    'primary key' => array('nid', 'cid', 'uid'),
    'indexes' => array(
      'uid_status' => array('uid', 'status'),
      'uid_cid' => array('uid', 'cid'),
      'uid_created' => array('uid', 'created'),
      'status_created' => array('status', 'created'),
    ),
  );

  return $schema;
}

/**
 * إضافة فهارس لتسريع استعلامات التحقق من التكرار وعرض التنبيهات والتنظيف الدوري.
 */
function task_manager_notifications_update_1000() {
  $indexes = array(
    'uid_cid' => array('uid', 'cid'),
    'uid_created' => array('uid', 'created'),
    'status_created' => array('status', 'created'),
  );
  foreach ($indexes as $name => $fields) {
    if (!db_index_exists('task_manager_notifications', $name)) {
      db_add_index('task_manager_notifications', $name, $fields);
    }
  }
}
